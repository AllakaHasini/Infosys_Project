# ============================================================
# eKYC Risk Intelligence — Backend Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# ============================================================

# --- Application ---
APP_NAME="eKYC Risk Intelligence"
APP_VERSION="1.0.0"
DEBUG=false
SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- MongoDB ---
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=ekyc_risk_intelligence

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_PRIVATE_NETWORK_CORS=true

# --- Admin Seed Account (used only by scripts/init_db.py) ---
ADMIN_EMAIL=admin@ekyc.local
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- MOSIP Integration (leave blank to use mock provider) ---
MOSIP_BASE_URL=
MOSIP_PARTNER_ID=
MOSIP_API_KEY=
MOSIP_MACHINE_ID=
MOSIP_CENTER_ID=

# --- eSignet / OIDC Integration (leave blank to use mock provider) ---
ESIGNET_BASE_URL=
ESIGNET_CLIENT_ID=
ESIGNET_CLIENT_SECRET=
ESIGNET_REDIRECT_URI=http://localhost:5173/auth/callback

# --- Risk Score Thresholds (0-100) ---
RISK_LOW_THRESHOLD=30
RISK_MEDIUM_THRESHOLD=60
RISK_HIGH_THRESHOLD=80

# --- Upload Limits ---
MAX_UPLOAD_SIZE_MB=10

# --- Batch Processing ---
MAX_BATCH_SIZE=50
