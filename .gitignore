# ─── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
venv/
env/
.venv/
ENV/
env.bak/

# ─── Environment / Secrets ─────────────────────────────────
# NEVER commit real .env files — use .env.example instead
.env
.env.local
.env.production
.env.staging
backend/.env
frontend/.env
*.secret
secrets/
*.pem
*.key
*.cert
*.p12
*.pfx

# ─── Node / Frontend ───────────────────────────────────────
node_modules/
frontend/dist/
frontend/.env
frontend/.env.*
!frontend/.env.example
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Uploaded Identity Documents & Personal Data ───────────
# These may contain real Aadhaar, PAN, selfies, or ID docs
uploads/
uploads/temp/
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.pdf
*.tiff
# Exception: allow images explicitly placed in docs/ for README
!docs/**/*.png
!docs/**/*.jpg

# ─── Database Dumps & Exports ──────────────────────────────
*.dump
*.bson
*.sql
mongo_export/
db_backup/

# ─── IDE & Editor Settings ────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~
.project
.classpath

# ─── OS Generated ─────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ─── Testing & Coverage ───────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/

# ─── Logs ─────────────────────────────────────────────────
*.log
logs/
*.log.*

# ─── Build Artifacts ──────────────────────────────────────
*.pyc
*.pyo
*.pyd
.Python
*.so

# ─── Docker (keep compose file, ignore runtime data) ──────
.docker/
docker-data/
