# ============================================================
# eKYC Risk Intelligence — Frontend Environment Configuration
# ============================================================

# API Base URL:
# - Default: '/api' (routes requests through the Vite dev server proxy to localhost:8000)
# - For mobile access with direct backend HTTPS connection across LAN, set:
#   VITE_API_URL=https://<your-pc-ip>:8000/api
VITE_API_URL=/api

# Backend proxy target for Vite dev server (defaults to http://127.0.0.1:8000)
VITE_BACKEND_TARGET=http://127.0.0.1:8000
